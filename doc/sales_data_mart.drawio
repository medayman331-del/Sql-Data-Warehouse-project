ometry"/></mxCell><mxCell id="dim_products_r1" value="product_number" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="78.5" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r2" value="product_name" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="103.0" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r3" value="category_id" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="127.5" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r4" value="category" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="152.0" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r5" value="subcategory" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="176.5" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r6" value="maintenance" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="201.0" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r7" value="cost" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="225.5" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r8" value="product_line" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="250.0" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="dim_products_r9" value="start_date" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=24;fontStyle=1;fontSize=12;" vertex="1" parent="dim_products"><mxGeometry x="0" y="274.5" width="157" height="24.5" as="geometry"/></mxCell><mxCell id="note_title" value="Sales Calculation" style="text;html=1;align=left;verticalAlign=middle;fontStyle=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="738" y="383" width="160" height="24" as="geometry"/></mxCell><mxCell id="note_text" value="Sales = Quantity * price" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="738" y="405" width="170" height="22" as="geometry"/></mxCell><mxCell id="note_line" style="endArrow=none;dashed=1;dashPattern=1 3;html=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="718" y="315" as="sourcePoint"/><mxPoint x="736" y="378" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rel_cust" style="edgeStyle=none;html=1;endArrow=ERzeroToMany;endFill=0;startArrow=ERmandOne;startFill=0;" edge="1" parent="1" source="c_customer_key" target="f_customer_key"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rel_prod" style="edgeStyle=none;html=1;endArrow=ERzeroToMany;endFill=0;startArrow=ERmandOne;startFill=0;" edge="1" parent="1" source="p_product_key" target="f_product_key"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_c1" value="&lt;b&gt;customer_key&lt;/b&gt; (PK)&lt;br&gt;Surrogate key generated inside the Data Warehouse. Used to join the dimension to fact_sales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="320" height="50" as="geometry"/></mxCell><mxCell id="n_c1_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="135" as="sourcePoint"/><mxPoint x="372" y="148" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n_c2" value="&lt;b&gt;customer_id / customer_number&lt;/b&gt;&lt;br&gt;Original customer identifiers from the source system (Business Keys)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="320" height="50" as="geometry"/></mxCell><mxCell id="n_c2_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="200" as="sourcePoint"/><mxPoint x="372" y="188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n_c3" value="&lt;b&gt;birthdate&lt;/b&gt;&lt;br&gt;Customer birth date, coming from ERP (erp_cust_az12)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="320" height="50" as="geometry"/></mxCell><mxCell id="n_c3_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="325" as="sourcePoint"/><mxPoint x="372" y="348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n_c4" value="&lt;b&gt;country&lt;/b&gt;&lt;br&gt;Column appears twice (as in the original image). One is enough." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="320" height="45" as="geometry"/></mxCell><mxCell id="n_c4_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="387" as="sourcePoint"/><mxPoint x="372" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n_p1" value="&lt;b&gt;product_key&lt;/b&gt; (PK)&lt;br&gt;Surrogate key. Used to join the product to fact_sales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="125" width="260" height="45" as="geometry"/></mxCell><mxCell id="n_p1_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="147" as="sourcePoint"/><mxPoint x="1061" y="153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n_p2" value="&lt;b&gt;cost&lt;/b&gt;&lt;br&gt;Product cost. Used to calculate profit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="325" width="260" height="45" as="geometry"/></mxCell><mxCell id="n_p2_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="347" as="sourcePoint"/><mxPoint x="1061" y="353" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n_p3" value="&lt;b&gt;start_date&lt;/b&gt;&lt;br&gt;Date the product version became valid (keeps product history)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1090" y="385" width="260" height="45" as="geometry"/></mxCell><mxCell id="n_p3_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090" y="407" as="sourcePoint"/><mxPoint x="1061" y="402" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n_f1" value="&lt;b&gt;FK1 / FK2&lt;/b&gt;: foreign keys linking the fact table to the dimensions.&lt;br&gt;&lt;b&gt;order_number&lt;/b&gt;: order identifier (Degenerate Dimension)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="230" height="70" as="geometry"/></mxCell><mxCell id="n_f1_l" style="endArrow=oval;endFill=1;dashed=1;html=1;strokeColor=#f9a825;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715" y="450" as="sourcePoint"/><mxPoint x="715" y="366" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>